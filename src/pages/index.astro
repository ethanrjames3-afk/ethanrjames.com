---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { Content as About } from '../about.md';
import portrait from '../assets/me/portrait-alice.jpg';
import astronaut from '../assets/me/astronaut.jpg';
import newspaper from '../assets/me/newspaper-2002.jpg';
import grandCanyon from '../assets/hobbies/grand-canyon.jpg';
import grandCanyon2 from '../assets/hobbies/grand-canyon-2.jpg';
import canyonTrail from '../assets/hobbies/canyon-trail.jpg';
import lift from '../assets/hobbies/lift.jpg';
import slope from '../assets/hobbies/slope.jpg';
import oculus from '../assets/hobbies/oculus.jpg';
import oneWtc from '../assets/hobbies/one-wtc.jpg';
import nycBridges from '../assets/hobbies/nyc-bridges.jpg';
import urbanLight from '../assets/hobbies/urban-light.jpg';

const hobbies = [
  { src: grandCanyon, caption: 'Hiking the Grand Canyon', alt: 'The Colorado River deep in the Grand Canyon' },
  { src: grandCanyon2, caption: 'Grand Canyon', alt: 'A sandstone spire on a Grand Canyon rim' },
  { src: canyonTrail, caption: 'Hiking', alt: 'A trail winding into a canyon' },
  { src: lift, caption: 'Snowboarding', alt: 'A chairlift above a snowy run, in black and white' },
  { src: slope, caption: 'Snowboarding', alt: 'Tracks on a steep snow slope, in black and white' },
  { src: oculus, caption: 'Photography: the Oculus, New York', alt: "The ribbed white interior of New York's Oculus, in black and white" },
  { src: oneWtc, caption: 'Photography: One World Trade Center', alt: 'One World Trade Center from below, in black and white' },
  { src: nycBridges, caption: 'Photography: the Manhattan and Brooklyn bridges', alt: 'The Manhattan and Brooklyn bridges at dusk' },
  { src: urbanLight, caption: 'Photography: Urban Light, Los Angeles', alt: 'Rows of antique street lamps at Urban Light' },
];

const all = (await getCollection('work')).sort((a, b) => b.data.sort - a.data.sort);
const projects = all.filter((e) => e.data.kind === 'project');
const jobs = all.filter((e) => e.data.kind === 'job');
---

<Base>
  <section class="page-head home-head">
    <Image
      src={portrait}
      alt="Ethan standing in front of Eviation's Alice aircraft"
      widths={[240, 480]}
      sizes="10rem"
      class="portrait"
      loading="eager"
    />
    <h1>{SITE.name}</h1>
    <div class="prose lede-prose">
      <About />
    </div>
    {
      (SITE.email || SITE.links.length > 0) && (
        <p class="links">
          {SITE.email && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
          {SITE.links.map((l) => <a href={l.url}>{l.label}</a>)}
        </p>
      )
    }
  </section>

  <section class="section" aria-labelledby="experience">
    <h2 id="experience" class="section-title">Experience</h2>
    <ul class="rows">
      {
        jobs.map((j) => {
          const Row = j.body?.trim() ? 'a' : 'div';
          return (
            <li>
              <Row class="row" href={Row === 'a' ? `/work/${j.id}/` : undefined}>
                <span class="row-main">
                  <span class="row-title">{j.data.org}</span>
                  <span class="meta">{j.data.role}</span>
                </span>
                <span class="meta row-years">{j.data.years}</span>
              </Row>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="projects">
    <h2 id="projects" class="section-title">Projects</h2>
    <div class="carousel" data-carousel>
      <button type="button" class="car-btn prev" aria-label="Previous project">‹</button>
    <ul class="cards car-track" tabindex="0" aria-label="Projects">
      {
        projects.map((p) => (
          <li>
            <a class="card" href={`/work/${p.id}/`}>
              {(p.data.thumb ?? p.data.cover) && (
                <Image
                  src={(p.data.thumb ?? p.data.cover)!}
                  alt={(p.data.thumb ? p.data.thumbAlt : p.data.coverAlt) ?? ''}
                  widths={[400, 800]}
                  sizes="(min-width: 42rem) 20rem, 100vw"
                  class:list={['card-img', p.data.thumb ? 'thumb' : p.data.coverFit]}
                />
              )}
              <span class="card-title">{p.data.title}</span>
              <span class="meta">
                {p.data.org}
              </span>
              <span class="card-summary">{p.data.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
      <button type="button" class="car-btn next" aria-label="Next project">›</button>
    </div>
    <div class="car-dots"></div>
  </section>

  <section class="section" aria-labelledby="hobbies">
    <h2 id="hobbies" class="section-title">Hobbies</h2>
    <div class="carousel" data-carousel>
      <button type="button" class="car-btn prev" aria-label="Previous photo">‹</button>
    <ul class="photo-strip car-track" tabindex="0" aria-label="Hobby photos">
      {
        hobbies.map((h) => (
          <li>
            <figure>
              <a href={h.src.src}>
                <Image src={h.src} alt={h.alt} widths={[400, 800]} sizes="22rem" />
              </a>
              <figcaption>{h.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
      <button type="button" class="car-btn next" aria-label="Next photo">›</button>
    </div>
    <div class="car-dots"></div>
  </section>

  <section class="section" aria-labelledby="background">
    <h2 id="background" class="section-title">Background</h2>
    <div class="prose">
      <p>
        I grew up a military brat, the son of an Air Force pilot and a nurse, mostly in Texas. I always wanted to help
        my dad with projects in his workshop, whether that was building model airplanes and rockets or odd jobs around
        the house.
      </p>
    </div>
    <div class="bg-photos">
      <figure>
        <a href={astronaut.src}><Image src={astronaut} alt="Ethan as a kid, dressed as an astronaut" widths={[400, 750]} sizes="(min-width: 42rem) 20rem, 50vw" /></a>
        <figcaption>Suited up as an astronaut</figcaption>
      </figure>
      <figure>
        <a href={newspaper.src}><Image src={newspaper} alt="A 2002 Rockwall-Rowlett Morning News clipping of Ethan's dad assembling a radio-controlled plane while Ethan and his brother watch" widths={[400, 800, 1333]} sizes="(min-width: 42rem) 20rem, 50vw" /></a>
        <figcaption>In the Rockwall-Rowlett Morning News at age 3, waiting for my dad's RC plane to take off</figcaption>
      </figure>
    </div>
  </section>
  <script>
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((car) => {
      const track = car.querySelector<HTMLElement>('.car-track')!;
      const items = Array.from(track.children) as HTMLElement[];
      const prev = car.querySelector<HTMLButtonElement>('.car-btn.prev')!;
      const next = car.querySelector<HTMLButtonElement>('.car-btn.next')!;
      const dotsEl = car.nextElementSibling as HTMLElement;
      const label = track.getAttribute('aria-label') ?? 'item';
      const dots = items.map((li, i) => {
        const d = document.createElement('button');
        d.type = 'button';
        const name = li.querySelector('.card-title, figcaption')?.textContent?.trim();
        d.setAttribute('aria-label', `${label}: go to ${name ?? i + 1}`);
        d.addEventListener('click', () => go(i));
        dotsEl.appendChild(d);
        return d;
      });
      const left = (i: number) => items[i].offsetLeft - items[0].offsetLeft;
      const max = () => track.scrollWidth - track.clientWidth;
      const current = () => {
        if (track.scrollLeft >= max() - 2) return items.length - 1;
        let best = 0;
        items.forEach((_, i) => { if (Math.abs(left(i) - track.scrollLeft) < Math.abs(left(best) - track.scrollLeft)) best = i; });
        return best;
      };
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const go = (i: number) => {
        track.scrollTo({
          left: Math.min(left(Math.max(0, Math.min(items.length - 1, i))), max()),
          behavior: reduce.matches || document.hidden ? 'auto' : 'smooth',
        });
        setTimeout(update, 600);
      };
      const update = () => {
        const c = current();
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max() - 2;
        dots.forEach((d, i) => d.setAttribute('aria-current', String(i === c)));
        const img = items[0].querySelector('img');
        if (img?.offsetHeight) car.style.setProperty('--car-mid', `${img.offsetHeight / 2}px`);
      };
      prev.addEventListener('click', () => go(current() - 1));
      next.addEventListener('click', () => go(current() + 1));
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
      });

      // Drag with a mouse; touch and trackpads scroll natively.
      let startX = 0, startLeft = 0, dragging = false, moved = false;
      track.querySelectorAll('img, a').forEach((el) => el.setAttribute('draggable', 'false'));
      track.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        dragging = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
      });
      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        if (!moved && Math.abs(dx) > 5) { moved = true; track.classList.add('dragging'); }
        if (moved) track.scrollLeft = startLeft - dx;
      });
      window.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        if (moved) { track.classList.remove('dragging'); go(current()); setTimeout(() => (moved = false), 0); }
      });
      track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      window.addEventListener('load', update);
      items[0].querySelector('img')?.addEventListener('load', update);
      update();
    });
  </script>
</Base>
