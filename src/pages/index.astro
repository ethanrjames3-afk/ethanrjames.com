---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { Content as About } from '../about.md';
import { featured } from '../photos';
import portrait from '../assets/me/portrait-alice.jpg';

const all = (await getCollection('work')).sort((a, b) => b.data.sort - a.data.sort);
const projects = all.filter((e) => e.data.kind === 'project');
const jobs = all.filter((e) => e.data.kind === 'job');
---

<Base>
  <section class="page-head home-head">
    <Image
      src={portrait}
      alt="Ethan standing in front of Eviation's Alice aircraft"
      widths={[240, 480]}
      sizes="10rem"
      class="portrait"
      loading="eager"
    />
    <h1>{SITE.name}</h1>
    <div class="prose lede-prose">
      <About />
    </div>
    {
      (SITE.email || SITE.links.length > 0) && (
        <p class="links">
          {SITE.email && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
          {SITE.links.map((l) => <a href={l.url}>{l.label}</a>)}
        </p>
      )
    }
  </section>

  <section class="section" aria-labelledby="projects">
    <h2 id="projects" class="section-title">Projects</h2>
    <ul class="cards">
      {
        projects.map((p) => (
          <li>
            <a class="card" href={`/work/${p.id}/`}>
              {p.data.cover && (
                <Image
                  src={p.data.cover}
                  alt={p.data.coverAlt ?? ''}
                  widths={[400, 800]}
                  sizes="(min-width: 42rem) 20rem, 100vw"
                  class:list={['card-img', p.data.coverFit]}
                />
              )}
              <span class="card-title">{p.data.title}</span>
              <span class="meta">
                {p.data.org} · {p.data.years}
              </span>
              <span class="card-summary">{p.data.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="experience">
    <h2 id="experience" class="section-title">Experience</h2>
    <ul class="rows">
      {
        jobs.map((j) => {
          const Row = j.body?.trim() ? 'a' : 'div';
          return (
            <li>
              <Row class="row" href={Row === 'a' ? `/work/${j.id}/` : undefined}>
                <span class="row-main">
                  <span class="row-title">{j.data.org}</span>
                  <span class="meta">{j.data.role}</span>
                </span>
                <span class="meta row-years">{j.data.years}</span>
              </Row>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="photography">
    <h2 id="photography" class="section-title">Photography</h2>
    <div class="photo-strip">
      {
        featured.map((p) => (
          <a href="/photos/">
            <Image src={p.src} alt={p.alt} widths={[300, 600]} sizes="(min-width: 42rem) 13rem, 33vw" />
          </a>
        ))
      }
    </div>
    <p class="more"><a href="/photos/">All photos →</a></p>
  </section>
</Base>
